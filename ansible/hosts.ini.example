[bastion]
bastion-jump ansible_host=<bastion_host_public_ip> ansible_user=***

[backendservers]
be-server-1 ansible_host=10.0.1.4 ansible_user=***
be-server-2 ansible_host=10.0.1.5 ansible_user=***

[webservers:vars]
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ProxyJump=***@<bastion_host_public_ip>'